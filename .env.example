# Copia este archivo a .env en la raíz del repo. .env no se sube.
# Los valores de abajo son marcadores de desarrollo local, no datos del rancho.
# Los comandos de base y el servidor HTTP leen este archivo.
# El servidor no aplica migraciones ni siembra al arrancar.
# Lo necesita para resolver la sesión (`DATABASE_URL`).

DATABASE_URL=postgres://rancho:rancho@127.0.0.1:5432/rancho

# Si se define, las pruebas usan ese PostgreSQL.
# Si se deja comentada, las pruebas arrancan PGlite en el proceso.
# TEST_DATABASE_URL=postgres://rancho:rancho@127.0.0.1:5432/rancho_test

# Nombre del único rancho que crea `npm run db:seed -w @rancho/api`.
# Sin este valor la semilla se niega: no inventa un nombre.
RANCH_NAME=
