# Copia este archivo a .env en la raíz del repo. .env no se sube.
# Los valores de abajo son marcadores de desarrollo local, no datos del rancho.
# Los comandos de base y el servidor HTTP leen este archivo.
# El servidor no aplica migraciones ni siembra al arrancar.
#
# Para correr todo sin PostgreSQL ni Docker: `npm run local`.
# Ese comando crea `.datos/`, genera SESSION_SECRET si esta línea está vacía,
# pregunta RANCH_NAME y la primera cuenta si faltan, y arranca. La segunda vez
# no repite nada. No usa DATABASE_URL: la base embebida se queda en esta máquina.
# Ver docs/development/correr-local.md.

DATABASE_URL=postgres://rancho:rancho@127.0.0.1:5432/rancho

# Firma la huella de las cookies de sesión. El servidor no arranca sin él ni
# con uno más corto de 32 caracteres: no hay valor de relleno.
# Genera uno con: openssl rand -base64 32
# No repitas el mismo secreto entre instalaciones.
SESSION_SECRET=

# Si se define, las pruebas usan ese PostgreSQL.
# Si se deja comentada, las pruebas arrancan PGlite en el proceso.
# Cada archivo de pruebas crea su propia base rancho_test_* y la borra al terminar,
# así que esta conexión necesita poder CREATE DATABASE. La base de la URL es solo
# el punto de entrada: apúntala a una que exista (rancho_test, o rancho mismo).
# TEST_DATABASE_URL=postgres://rancho:rancho@127.0.0.1:5432/rancho_test

# Si se define, las pruebas de punta a punta usan ese PostgreSQL.
# Si se deja comentada, levantan su propia base desechable con PGlite.
# E2E_DATABASE_URL=postgres://rancho:rancho@127.0.0.1:5432/rancho_e2e

# Nombre del único rancho que crea `npm run db:seed -w @rancho/api`.
# Sin este valor la semilla se niega: no inventa un nombre.
RANCH_NAME=

# Puerto y host del proceso. Tienen omisión (`3000` y `127.0.0.1`).
# PORT=3000
# HOST=127.0.0.1

# Conexiones del pool. La omisión es 10. Bájalo a 1 solo si tu base atiende
# una conexión a la vez.
# DB_POOL=10

# Dónde está la web construida, si no es `apps/web/dist`.
# WEB_DIST=
