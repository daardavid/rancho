{
  "name": "@rancho/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/cli-migrar.ts",
    "db:reset": "tsx src/infrastructure/db/cli-reset.ts",
    "db:seed": "tsx src/infrastructure/db/cli-semilla.ts"
  },
  "dependencies": {
    "@rancho/api-contracts": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
