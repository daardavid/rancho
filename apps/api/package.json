{
  "name": "@rancho/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/cli-migrar.ts",
    "db:reset": "tsx src/infrastructure/db/cli-reset.ts",
    "db:seed": "tsx src/infrastructure/db/cli-semilla.ts",
    "cuenta:crear": "tsx src/infrastructure/identity/cli-cuenta.ts",
    "local": "tsx src/infrastructure/local/cli.ts",
    "contrasena": "tsx src/infrastructure/local/cli-contrasena.ts",
    "respaldo": "tsx src/infrastructure/local/cli-respaldo.ts",
    "restaurar": "tsx src/infrastructure/local/cli-restaurar.ts",
    "cargar-respaldo": "tsx src/infrastructure/db/cli-cargar-respaldo.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@node-rs/argon2": "^2.2.2",
    "@rancho/api-contracts": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@electric-sql/pglite-tools": "^0.4.17",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
